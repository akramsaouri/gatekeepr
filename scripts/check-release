#!/bin/sh
# Checks the files scripts/build-release wrote, as a user would get them: it
# checks the checksums, unpacks the archive, and checks that the binary is
# universal, signed, and reports the right version.
#
#   scripts/check-release               # checks dist/
#   scripts/check-release DIR           # checks DIR/
#   scripts/check-release DIR v0.3.0    # also checks the tag matches the version
#
# The release workflow passes the tag it runs for, so a tag that doesn't match
# internal/cli/cli.go fails before anything is published.

set -eu

cd "$(dirname "$0")/.."

dir="${1:-dist}"
tag="${2:-}"

fail() {
    echo "check-release: $*" >&2
    exit 1
}

version=$(sed -n 's/^const Version = "\(.*\)"$/\1/p' internal/cli/cli.go)
[ -n "$version" ] || fail "can't read the version from internal/cli/cli.go"
cli_name="gatekeepr-$version-macos-universal"
cli_tar="$cli_name.tar.gz"

if [ -n "$tag" ] && [ "$tag" != "v$version" ]; then
    fail "tag $tag doesn't match version $version in internal/cli/cli.go"
fi

echo "==> Files"
files=$(cd "$dir" && ls | sort | tr '\n' ' ')
[ "$files" = "SHA256SUMS $cli_tar " ] || fail "$dir has '$files', expected 'SHA256SUMS $cli_tar '"

echo "==> Checksums"
listed=$(awk '{ print $2 }' "$dir/SHA256SUMS" | tr '\n' ' ')
[ "$listed" = "$cli_tar " ] || fail "SHA256SUMS lists '$listed', expected '$cli_tar '"
(cd "$dir" && shasum -a 256 -c SHA256SUMS)

echo "==> Archive"
contents=$(tar -tzf "$dir/$cli_tar" | sort | tr '\n' ' ')
expected="$cli_name/ $cli_name/LICENSE $cli_name/README.md $cli_name/gatekeepr "
[ "$contents" = "$expected" ] || fail "$cli_tar holds '$contents', expected '$expected'"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
tar -C "$work" -xzf "$dir/$cli_tar"
cli="$work/$cli_name/gatekeepr"
[ -x "$cli" ] || fail "$cli_tar's gatekeepr isn't executable"

echo "==> Architectures"
archs=$(lipo -archs "$cli")
echo "    gatekeepr: $archs"
for want in arm64 x86_64; do
    case " $archs " in
        *" $want "*) ;;
        *) fail "gatekeepr has no $want slice" ;;
    esac
done

echo "==> Signature"
codesign --verify --strict --verbose=2 "$cli"
details=$(codesign -dv "$cli" 2>&1)
echo "$details" | grep -q 'flags=.*runtime' || fail "gatekeepr isn't signed with the hardened runtime"
# Ad hoc unless scripts/build-release was given a Developer ID.
if [ -z "${GATEKEEPR_SIGN_IDENTITY:-}" ]; then
    echo "$details" | grep -q 'Signature=adhoc' || fail "gatekeepr isn't signed ad hoc"
fi

echo "==> Versions"
cli_version=$("$cli" --version)
echo "    internal/cli/cli.go:        $version"
echo "    gatekeepr --version:        $cli_version"
[ "$cli_version" = "$version" ] || fail "gatekeepr --version says $cli_version, expected $version"
# Runs the Intel slice too, where Rosetta is installed.
if arch -x86_64 /usr/bin/true 2>/dev/null; then
    cli_version_x86=$(arch -x86_64 "$cli" --version)
    echo "    gatekeepr --version x86_64: $cli_version_x86"
    [ "$cli_version_x86" = "$version" ] || fail "the x86_64 binary says $cli_version_x86, expected $version"
fi
if [ -n "$tag" ]; then
    echo "    tag:                        $tag"
fi

echo "==> OK: gatekeepr $version"
