#!/bin/sh
# Renders the app icon, assets/icon/AppIcon.icns, from its two SVG sources:
#
#   assets/icon/icon.svg         128 px and up (@1x and @2x): the frosted-glass G
#   assets/icon/icon-small.svg   16 and 32 px (@1x and @2x): a flat G that stays legible
#
#   scripts/make-icon
#
# It also writes docs/icon-contact-sheet.png: every image in the .icns at its
# actual pixel size, read back out of the .icns, with 16 and 32 px magnified.
#
# It needs rsvg-convert (brew install librsvg), which GitHub's macOS runners
# don't have, so both files are committed and scripts/build-app only copies the
# .icns. Run this after changing either SVG, and commit what it writes.

set -eu

cd "$(dirname "$0")/.."

command -v rsvg-convert >/dev/null || {
    echo "make-icon: needs rsvg-convert: brew install librsvg" >&2
    exit 1
}

icns=assets/icon/AppIcon.icns
sheet=docs/icon-contact-sheet.png
srgb="/System/Library/ColorSync/Profiles/sRGB Profile.icc"

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir "$work/AppIcon.iconset"

# render SOURCE PIXELS NAME: SVG colours are sRGB, so the PNG says so.
render() {
    png="$work/AppIcon.iconset/$3.png"
    rsvg-convert --width "$2" --height "$2" "assets/icon/$1" --output "$png"
    sips --embedProfile "$srgb" "$png" >/dev/null
}

echo "==> Rendering the iconset"
for size in 16 32; do
    render icon-small.svg "$size" "icon_${size}x${size}"
    render icon-small.svg $((size * 2)) "icon_${size}x${size}@2x"
done
for size in 128 256 512; do
    render icon.svg "$size" "icon_${size}x${size}"
    render icon.svg $((size * 2)) "icon_${size}x${size}@2x"
done

echo "==> Building $icns"
iconutil --convert icns --output "$icns" "$work/AppIcon.iconset"

# Read the .icns back, so the contact sheet shows what ships.
iconutil --convert iconset --output "$work/check.iconset" "$icns"
for image in 16x16:16 16x16@2x:32 32x32:32 32x32@2x:64 128x128:128 128x128@2x:256 \
    256x256:256 256x256@2x:512 512x512:512 512x512@2x:1024; do
    name="icon_${image%:*}"
    width=$(sips -g pixelWidth "$work/check.iconset/$name.png" 2>/dev/null | awk '/pixelWidth/ { print $2 }')
    if [ "$width" != "${image#*:}" ]; then
        echo "make-icon: $icns has $name at ${width:-no} px, expected ${image#*:}" >&2
        exit 1
    fi
done

echo "==> Writing $sheet"
# image NAME X Y [SCALE]: one image from the .icns, magnified without smoothing.
image() {
    px=$(sips -g pixelWidth "$work/check.iconset/$1.png" | awk '/pixelWidth/ { print $2 }')
    side=$((px * ${4:-1}))
    printf '<image href="check.iconset/%s.png" x="%s" y="%s" width="%s" height="%s" image-rendering="pixelated"/>\n' \
        "$1" "$2" "$3" "$side" "$side"
}
# label TEXT X Y [COLOUR]
label() {
    printf '<text x="%s" y="%s" fill="%s">%s</text>\n' "$2" "$3" "${4:-#6e6e73}" "$1"
}
# small OFFSET BACKGROUND INK: the 16 and 32 px images at actual size, then magnified.
small() {
    printf '<rect x="%s" y="1290" width="992" height="420" fill="%s"/>\n' "$1" "$2"
    image icon_16x16 $(($1 + 40)) 1404
    image icon_16x16@2x $(($1 + 110)) 1388
    image icon_32x32 $(($1 + 210)) 1388
    image icon_32x32@2x $(($1 + 290)) 1356
    label 16 $(($1 + 40)) 1460 "$3"
    label "16@2x" $(($1 + 110)) 1460 "$3"
    label 32 $(($1 + 210)) 1460 "$3"
    label "32@2x" $(($1 + 290)) 1460 "$3"
    image icon_16x16 $(($1 + 420)) 1340 16
    image icon_32x32 $(($1 + 706)) 1340 8
    label "16 px, x16" $(($1 + 420)) 1636 "$3"
    label "32 px, x8" $(($1 + 706)) 1636 "$3"
}
{
    echo '<svg xmlns="http://www.w3.org/2000/svg" width="1984" height="1710" font-family="Helvetica Neue, Helvetica, Arial, sans-serif" font-size="24">'
    echo '<rect width="1984" height="1290" fill="#f5f5f7"/>'
    label "AppIcon.icns: every image at its actual pixel size, read back out of the .icns" 40 56 "#1d1d1f"
    image icon_512x512@2x 40 100
    label "512@2x" 40 1160
    image icon_512x512 1104 100
    label "512" 1104 648
    image icon_256x256@2x 1104 676
    label "256@2x" 1104 1224
    image icon_256x256 1656 100
    label "256" 1656 392
    image icon_128x128@2x 1656 420
    label "128@2x" 1656 712
    image icon_128x128 1656 740
    label "128" 1656 904
    label "128 px and up:" 1656 980
    label "assets/icon/icon.svg" 1656 1012
    label "16 and 32 px:" 1656 1060
    label "icon-small.svg, below" 1656 1092
    small 0 "#ffffff" "#6e6e73"
    small 992 "#1e1e1e" "#a1a1a6"
    echo '</svg>'
} > "$work/sheet.svg"
rsvg-convert "$work/sheet.svg" --output "$sheet"

echo "==> Done. Commit $icns and $sheet."
