#!/bin/sh
# Builds everything a GitHub release ships:
#
#   gatekeepr-<version>-macos-universal.tar.gz    the CLI, with LICENSE and README.md
#   SHA256SUMS
#
#   scripts/build-release            # writes dist/
#   scripts/build-release OUT_DIR    # writes OUT_DIR/
#
# The binary is universal: one go build per architecture (arm64 and amd64),
# merged with lipo. It's signed ad hoc with the hardened runtime, unless
# GATEKEEPR_SIGN_IDENTITY names a Developer ID. Needs macOS for lipo and
# codesign. The version comes from internal/cli/cli.go.
#
# scripts/check-release checks the result. The release workflow runs both on a
# v* tag, and CI runs both on every PR, so the packaging can't break unnoticed
# between releases.

set -eu

cd "$(dirname "$0")/.."

out_dir="${1:-dist}"
version=$(sed -n 's/^const Version = "\(.*\)"$/\1/p' internal/cli/cli.go)
if [ -z "$version" ]; then
    echo "build-release: can't read the version from internal/cli/cli.go" >&2
    exit 1
fi
cli_name="gatekeepr-$version-macos-universal"
cli_tar="$cli_name.tar.gz"

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
rm -rf "$out_dir"
mkdir -p "$out_dir"

echo "==> Building gatekeepr $version with $(go version | cut -d' ' -f3)"
for arch in arm64 amd64; do
    CGO_ENABLED=0 GOOS=darwin GOARCH=$arch go build -trimpath -ldflags="-s -w" -o "$work/gatekeepr-$arch" .
done

mkdir "$work/$cli_name"
cli="$work/$cli_name/gatekeepr"
lipo -create -output "$cli" "$work/gatekeepr-arm64" "$work/gatekeepr-amd64"
cp LICENSE README.md "$work/$cli_name/"

# No Developer ID for now, so ad hoc: curl and gh don't quarantine what they
# download, so it runs as is. The hardened runtime is on, as notarization
# would require.
identity="${GATEKEEPR_SIGN_IDENTITY:--}"
if [ "$identity" = "-" ]; then
    echo "==> Signing ad hoc"
    codesign --force --options runtime --sign - "$cli"
else
    echo "==> Signing as $identity"
    codesign --force --options runtime --timestamp --sign "$identity" "$cli"
fi
codesign --verify --strict "$cli"

echo "==> Packaging into $out_dir"
# COPYFILE_DISABLE stops tar adding AppleDouble ._ files for extended attributes.
COPYFILE_DISABLE=1 tar -C "$work" -czf "$out_dir/$cli_tar" "$cli_name"
(cd "$out_dir" && shasum -a 256 "$cli_tar" > SHA256SUMS)

ls -l "$out_dir"
echo "==> Done. scripts/check-release $out_dir checks what's inside."
